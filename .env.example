# Focus Toolkit — example configuration
#
# Copy to .env and edit:   cp .env.example .env
#
# .env is gitignored. Never commit it. Never put a real value in THIS file.
# ---------------------------------------------------------------------------


# ---- Model storage --------------------------------------------------------
# Where AI model weights live. Roughly 4 GB once Phase 3 is installed.
#
# IMPORTANT: point this at your LARGE drive, not the 112 GB SSD.
#   Windows shop PC:  D:/focus-toolkit/models
#   macOS:            /Users/you/focus-toolkit-models
#
MODELS_DIR=./models


# ---- Server ---------------------------------------------------------------
# Host is 127.0.0.1 and must stay that way. Binding to 0.0.0.0 would expose
# client artwork and your API key to everyone on the shop Wi-Fi.
# See SECURITY.md before changing this.
HOST=127.0.0.1
PORT=8000

# Open the default browser automatically on start.
OPEN_BROWSER=true


# ---- Device ---------------------------------------------------------------
# auto | cpu | cuda | coreml
# Leave on auto. Override only when troubleshooting.
DEVICE=auto


# ---- API keys -------------------------------------------------------------
# DO NOT PUT KEYS HERE.
#
# Add them in the app's Settings tab instead, where they are encrypted at rest
# and never sent back to the browser in plaintext. See SETTINGS.md.
#
# This block is a deliberate signpost, not a config section.
