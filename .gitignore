# ---- Secrets -------------------------------------------------------------
# Never commit. If a key is ever committed: ROTATE IT FIRST, then clean history.
.env
.env.local
*.key
.secret_key

# ---- Data ----------------------------------------------------------------
# SQLite holds encrypted API keys, client glossaries and job history.
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Models --------------------------------------------------------------
# ~4 GB of weights. Lives on the large drive, set via MODELS_DIR in .env.
models/
*.onnx
*.pth
*.safetensors

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---- Frontend ------------------------------------------------------------
# node_modules never ships. dist/ is built output — see the note below.
node_modules/
frontend/dist/

# The shop PC package, built by scripts/package_windows.py. A build artefact of
# a build artefact — regenerate it, never commit it. Unignored, `git add -A`
# would commit a second copy of the whole backend plus a zip of it.
/dist/
frontend/.vite/
npm-debug.log*

# ---- Working files -------------------------------------------------------
# Client artwork must not accumulate in the repo.
tmp/
temp/
uploads/
output/

# ---- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json


# NOTE on frontend/dist/

# The shop PC package, built by scripts/package_windows.py. A build artefact of
# a build artefact — regenerate it, never commit it. Unignored, `git add -A`
# would commit a second copy of the whole backend plus a zip of it.
/dist/
# Ignored during development, and **force-added on every release commit**. That
# is the settled policy, not one of two options: the shop PC has no Node, so a
# plain clone has to be runnable.
#
#     cd frontend && npm run build && cd ..
#     git add -f frontend/dist
#     uv run python scripts/check_release.py    # must pass before pushing
#
# The check is not optional. `519de89` changed ~2,000 lines of frontend and never
# re-added dist, so the tracked bundle stayed the pre-Phase-5 UI with no AI
# screens in it at all, and nothing said so. See NEXT.md 0.1.
.claude/settings.local.json
